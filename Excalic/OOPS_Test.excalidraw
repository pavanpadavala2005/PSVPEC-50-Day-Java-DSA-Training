    {
      "id": "1am5_vEPJNcNErbt1NNGl",
      "type": "text",
      "x": 16215.362133509923,
      "y": -12206.02617234745,
      "width": 1702.1876220703125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
