      "isDeleted": true,
      "boundElements": [],
      "updated": 1781685202510,
      "link": null,
      "locked": false,
      "text": "The main Problem in BufferedStreamReader is that there is not direct Type convertion\nwe have to do manualy may rise Runtime Exceptions that is where Scanner class was introduced ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The main Problem in BufferedStreamReader is that there is not direct Type convertion\nwe have to do manualy may rise Runtime Exceptions that is where Scanner class was introduced ",
      "autoResize": true,
      "lineHeight": 1.25
