      "updated": 1781685202510,
      "link": null,
      "locked": false,
      "text": "Reading console Inputs\nreads in the form of Bytes like System.in.read()\nbut converts the Stream of Bytes to Stream of Characters\nInputStremReader is alone not sufficient to read\nwe need BufferedReader to convert the Stream of Characters to String",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reading console Inputs\nreads in the form of Bytes like System.in.read()\nbut converts the Stream of Bytes to Stream of Characters\nInputStremReader is alone not sufficient to read\nwe need BufferedReader to convert the Stream of Characters to String",
      "autoResize": true,
      "lineHeight": 1.25
    },
