      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Arrays are \n              1.  Fixed Size\n              2. Same Data type Only\n              3. Index Based\n              4. Continuous Memory\n              5. Faster Access",
      "autoResize": true,
