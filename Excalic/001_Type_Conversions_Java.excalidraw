      "updated": 1778744322141,
      "link": null,
      "locked": false,
      "text": "class Student {\n\n    int age;\n}\n\nclass Test {\n\n    static void change(Student s) {\n        s.age = 50;\n    }\n\n    public static void main(String[] args) {\n\n        Student st = new Student();\n\n        st.age = 20;\n\n        change(st);\n\n        System.out.println(st.age);\n    }\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Student {\n\n    int age;\n}\n\nclass Test {\n\n    static void change(Student s) {\n        s.age = 50;\n    }\n\n    public static void main(String[] args) {\n\n        Student st = new Student();\n\n        st.age = 20;\n\n        change(st);\n\n        System.out.println(st.age);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
