    {
      "id": "PQ-7r7fZ-8j0agY51Ymvo",
      "type": "text",
      "x": 23197.803048372407,
      "y": -14886.411888012586,
      "width": 962.7235107421875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
