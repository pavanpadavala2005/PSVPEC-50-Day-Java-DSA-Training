      "updated": 1778747207818,
      "link": null,
      "locked": false,
      "text": "void main(){\n    Student st = new Student(\"Pavan\",21,'M',\n                    new int[]{10,20,30,40,50});\n\n}\n\nclass Student {\n    String name;\n    int age;\n    char gender;\n    int[] marks;\n\n    public Student(String name, int age,char\ngender, int[] marks) {\n        this.name = name;\n        this.age = age;\n        this.gender = gender;\n        this.marks = marks;\n \n   }\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void main(){\n    Student st = new Student(\"Pavan\",21,'M',\n                    new int[]{10,20,30,40,50});\n\n}\n\nclass Student {\n    String name;\n    int age;\n    char gender;\n    int[] marks;\n\n    public Student(String name, int age,char gender, int[] marks) {\n        this.name = name;\n        this.age = age;\n        this.gender = gender;\n        this.marks = marks;\n \n   }\n}",
      "autoResize": false,
      "lineHeight": 1.25
