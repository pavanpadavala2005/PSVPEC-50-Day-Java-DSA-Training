      "text": "> As arrays are fixed in size so it only had a property called",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> As arrays are fixed in size so it only had a property called",
