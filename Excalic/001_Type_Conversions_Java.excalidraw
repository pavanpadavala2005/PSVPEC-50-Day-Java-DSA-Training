    {
      "id": "e_nlL-wWSOfF74pIJEJkA",
      "type": "text",
      "x": 25510.572552930167,
      "y": -13673.32678066804,
      "width": 712.23583984375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
