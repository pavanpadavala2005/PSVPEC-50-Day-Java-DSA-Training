      "updated": 1778744322141,
      "link": null,
      "locked": false,
      "text": "class Test {\n\n    static void change(int x) {\n        x = 100;t\n    }\n\n    public static void main(String[] args) {\n\n        int a = 10;\n\n        change(a);\n\n        System.out.println(a);\n    }\n}",
