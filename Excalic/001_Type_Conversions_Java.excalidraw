      "isDeleted": false,
      "boundElements": [],
      "updated": 1778744303858,
      "link": null,
      "locked": false,
      "text": "So usually in java Type conversion happens in such a way that all\nsmall sized data types will be automatically converted means expanded\ncalled Widening",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So usually in java Type conversion happens in such a way that all\nsmall sized data types will be automatically converted means expanded\ncalled Widening",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lKMM4xesmP2GAmWiDZnQR",
      "type": "text",
      "x": 25470.8982433698,
      "y": -14838.178747401911,
      "width": 965.0758056640625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9EV",
      "roundness": null,
      "seed": 517916891,
      "version": 719,
      "versionNonce": 1899606106,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780462002299,
      "link": null,
      "locked": false,
      "text": "So Whenever we are converting from big Size data types to Small size \nData type there some bits may loss\nwhile shrinking from Large --> Small that will be some tricky",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So Whenever we are converting from big Size data types to Small size \nData type there some bits may loss\nwhile shrinking from Large --> Small that will be some tricky",
      "autoResize": true,
      "lineHeight": 1.25
    },
