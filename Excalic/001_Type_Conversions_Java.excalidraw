        "6cyKUhpGa1xUSkSaonngP"
      ],
      "frameId": null,
      "index": "bAg",
      "roundness": null,
      "seed": 2044808405,
      "version": 1465,
      "versionNonce": 714433594,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778744303859,
      "link": null,
      "locked": false,
      "text": "One thing we should consider is that when we are \nconverting from Bigger to Smaller it only focuses on\nlast 8 or 16 or 32 bits only",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One thing we should consider is that when we are \nconverting from Bigger to Smaller it only focuses on\nlast 8 or 16 or 32 bits only",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gTbMw0DMUsU8PLnmqo_64",
      "type": "text",
      "x": 26233.423386600065,
      "y": -13441.124123200105,
      "width": 507.8077392578125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "6cyKUhpGa1xUSkSaonngP"
      ],
      "frameId": null,
      "index": "bAg8",
      "roundness": null,
      "seed": 1662680949,
      "version": 1688,
      "versionNonce": 2131596390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778744303859,
      "link": null,
      "locked": false,
      "text": "integer of 32 bits was shirnked into \nbyte of 8 bits",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "integer of 32 bits was shirnked into \nbyte of 8 bits",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yk_8-8e78Bh_agPmL1icI",
      "type": "text",
      "x": 25521.332494455382,
      "y": -13348.200464461856,
      "width": 503.18780517578125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "6cyKUhpGa1xUSkSaonngP"
      ],
      "frameId": null,
      "index": "bAgG",
      "roundness": null,
      "seed": 1757943093,
      "version": 1970,
      "versionNonce": 1905315066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778744303859,
      "link": null,
      "locked": false,
      "text": "but if we observe MSB bit it is --> 1\nso our system will get confused and \nstore in the form of 2's compliment",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "but if we observe MSB bit it is --> 1\nso our system will get confused and \nstore in the form of 2's compliment",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dkGtkEJ3yknclP_HKM7o1",
      "type": "text",
      "x": 25535.148448402633,
      "y": -13001.33270774242,
      "width": 1012.8717041015625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "6cyKUhpGa1xUSkSaonngP"
      ],
      "frameId": null,
      "index": "bAgl",
      "roundness": null,
      "seed": 562550197,
      "version": 2360,
      "versionNonce": 1126987578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778744303859,
      "link": null,
      "locked": false,
      "text": "While accessing if we retrive that we will get -56 This is called truncation",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "While accessing if we retrive that we will get -56 This is called truncation",
      "autoResize": true,
      "lineHeight": 1.25
