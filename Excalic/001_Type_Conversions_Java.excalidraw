      "updated": 1778747471427,
      "link": null,
      "locked": false,
      "text": "class Header    --->  8 Bytes\nclass Pointer   --->  4 Bytes\n\n         name    --->  4 Bytes     ( Reference Varuiable)\n         age      --->  4 Bytes     ( Primitive )\n         marks   --->  4 Bytes      ( Reference variable )\n\n         Total   --->  24 Bytes \n          \n\n         Padding ---> 8 Bytes       ( Padding used to make whole memory \n                                            which is divisible by 8  32-24 ==> 8 Bytes)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Header    --->  8 Bytes\nclass Pointer   --->  4 Bytes\n\n         name    --->  4 Bytes     ( Reference Varuiable)\n         age      --->  4 Bytes     ( Primitive )\n         marks   --->  4 Bytes      ( Reference variable )\n\n         Total   --->  24 Bytes \n          \n\n         Padding ---> 8 Bytes       ( Padding used to make whole memory \n                                            which is divisible by 8  32-24 ==> 8 Bytes)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4Z54hEAb1QpCQfXU9j_kC",
