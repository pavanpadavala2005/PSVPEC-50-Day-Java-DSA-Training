      "updated": 1778744303859,
      "link": null,
      "locked": false,
      "text": "So here we are using the  new keyword so the memory will be allocated\nin Heap memory",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So here we are using the  new keyword so the memory will be allocated\nin Heap memory",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V6ir91q0srYtxkKRpCTjn",
      "type": "text",
      "x": 28930.460010725794,
      "y": -14225.782624799922,
      "width": 917.5678100585938,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
