        }
      ],
      "updated": 1775810167622,
      "link": null,
      "locked": false,
      "text": "class Node:\n    def __init__(self,data):\n        self.left = None\n        self.data = data\n        self.right = None\n\nclass BinarySearchTree:\n    def __init__(self):\n        self.root = 20\n    def insert(self,data = 30):\n        self.root = self.insertHelper(self.root = 20,data = 30)\n    def insertHelper(self,root = 20,data = 30):\n        if root == None:\n            return Node(data)\n        if data < root.data:\n            root.left = self.insertHelper(root.left,data)\n        if data > root.data:\n            root.right = self.insertHelper(root.right,data)\n        return root\nbst = BinarySearchTree()\nbst.insert(20)\nbst.insert(7)\nbst.insert(30)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Node:\n    def __init__(self,data):\n        self.left = None\n        self.data = data\n        self.right = None\n\nclass BinarySearchTree:\n    def __init__(self):\n        self.root = 20\n    def insert(self,data = 30):\n        self.root = self.insertHelper(self.root = 20,data = 30)\n    def insertHelper(self,root = 20,data = 30):\n        if root == None:\n            return Node(data)\n        if data < root.data:\n            root.left = self.insertHelper(root.left,data)\n        if data > root.data:\n            root.right = self.insertHelper(root.right,data)\n        return root\nbst = BinarySearchTree()\nbst.insert(20)\nbst.insert(7)\nbst.insert(30)",
      "autoResize": true,
      "lineHeight": 1.25
    },
