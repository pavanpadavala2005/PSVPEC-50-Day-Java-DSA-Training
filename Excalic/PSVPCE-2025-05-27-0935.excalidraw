      "boundElements": [],
      "updated": 1775883918152,
      "link": null,
      "locked": false,
      "text": "    def deleteNodeHelper(self,root = 10,key = 10):\n        if root is None:\n            return\n\n        if key < root.data:\n            root.left = self.deleteNodeHelper(root.left,key)\n        elif key > root.data:\n            root.right = self.deleteNodeHelper(root.right,key)\n        else:\n            if root.left is None:\n                return root.right\n            if root.right is None:\n                return root.left\n            \n            minElem = self.minElementHelper(root.right)\n            root.data = minElem\n            root.right = self.deleteNodeHelper(root.right,minElem)\n\n        return root",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    def deleteNodeHelper(self,root = 10,key = 10):\n        if root is None:\n            return\n\n        if key < root.data:\n            root.left = self.deleteNodeHelper(root.left,key)\n        elif key > root.data:\n            root.right = self.deleteNodeHelper(root.right,key)\n        else:\n            if root.left is None:\n                return root.right\n            if root.right is None:\n                return root.left\n            \n            minElem = self.minElementHelper(root.right)\n            root.data = minElem\n            root.right = self.deleteNodeHelper(root.right,minElem)\n\n        return root",
      "autoResize": true,
      "lineHeight": 1.25
    },
