      "link": null,
      "locked": false,
      "text": "def maxSubArray(arr,k):\n    Result = 0\n    Current = 0\n    left = 0\n    for right in range(len(arr)):\n        Grow Window\n        if MEET WINDOW:\n            Do Something\n            Shrink window\n\n    return Result",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def maxSubArray(arr,k):\n    Result = 0\n    Current = 0\n    left = 0\n    for right in range(len(arr)):\n        Grow Window\n        if MEET WINDOW:\n            Do Something\n            Shrink window\n\n    return Result",
      "autoResize": true,
      "lineHeight": 1.25
