    {
      "id": "toitVwYUfe8OWKGC7Oqau",
      "type": "text",
      "x": 8266.253335319732,
      "y": -13675.817907170589,
      "width": 930.5994262695312,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Uv",
      "roundness": null,
      "seed": 382900240,
      "version": 240,
      "versionNonce": 962064883,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775728008265,
      "link": null,
      "locked": false,
      "text": "def maxSubArray(arr,k):\n    resArr = []\n    queue = []\n    left = 0\n    for i in range(len(arr)):\n        if arr[i] < 0:\n            queue.append(arr[i])\n        if i-left+1 == k:\n            if queue:\n                resArr.append(queue[0])\n            else:\n                resArr.append(0)\n            if queue and queue[0] == arr[left]:\n                queue.pop(0)\n            left += 1\n    return resArr\nprint(maxSubArray([-8,-2,3,-6,10],2))",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def maxSubArray(arr,k):\n    resArr = []\n    queue = []\n    left = 0\n    for i in range(len(arr)):\n        if arr[i] < 0:\n            queue.append(arr[i])\n        if i-left+1 == k:\n            if queue:\n                resArr.append(queue[0])\n            else:\n                resArr.append(0)\n            if queue and queue[0] == arr[left]:\n                queue.pop(0)\n            left += 1\n    return resArr\nprint(maxSubArray([-8,-2,3,-6,10],2))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
