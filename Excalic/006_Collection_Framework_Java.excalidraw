    {
      "id": "1am5_vEPJNcNErbt1NNGl",
      "type": "text",
      "x": 16201.07685518961,
      "y": -12177.455005355263,
      "width": 1702.1876220703125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
