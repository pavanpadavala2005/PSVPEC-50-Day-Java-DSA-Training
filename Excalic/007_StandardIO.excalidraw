        }
      ],
      "updated": 1780285345185,
      "link": null,
      "locked": false,
      "text": "next()         --->     String    --->      Reads single word\nnextLine()     --->     String    --->      Reads complete line\nnextInt()      --->     int       --->      Reads integer\nnextLong()     --->     long      --->      Reads long\nnextFloat()    --->     float     --->      Reads float\nnextDouble()   --->     double    --->      Reads double\nnextShort()    --->     short     --->      Reads short\nnextByte()     --->     byte      --->      Reads byte\nnextBoolean()  --->     boolean   --->      Reads true/false\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "next()         --->     String    --->      Reads single word\nnextLine()     --->     String    --->      Reads complete line\nnextInt()      --->     int       --->      Reads integer\nnextLong()     --->     long      --->      Reads long\nnextFloat()    --->     float     --->      Reads float\nnextDouble()   --->     double    --->      Reads double\nnextShort()    --->     short     --->      Reads short\nnextByte()     --->     byte      --->      Reads byte\nnextBoolean()  --->     boolean   --->      Reads true/false\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
