      "text": "An Array is a collection of similar type stored in continues memory locations\nwhich can be accessed, modified using Indexing",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Array is a collection of similar type stored in continues memory locations\nwhich can be accessed, modified using Indexing",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
