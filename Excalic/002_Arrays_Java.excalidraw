      "roundness": null,
      "seed": 1546382233,
      "version": 2027,
      "versionNonce": 1063149593,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778732403365,
      "link": null,
      "locked": false,
      "text": "from address 2012 if we read 4Bytes of memory\n2012 <--> 2016  we will get the value at arr[2]",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from address 2012 if we read 4Bytes of memory\n2012 <--> 2016  we will get the value at arr[2]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_7ipvvtATVcBXzTAOtNBS",
      "type": "text",
      "x": 28941.05529314418,
      "y": -12349.318525913079,
      "width": 1001.0877075195312,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VCkLsBTbosUV-dF8ouRUe"
      ],
      "frameId": null,
      "index": "bDL",
