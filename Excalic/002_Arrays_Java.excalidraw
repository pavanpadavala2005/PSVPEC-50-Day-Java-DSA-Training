      "boundElements": [],
      "updated": 1778731739188,
      "link": null,
      "locked": false,
      "text": "> first arr variable is pushed into stack memory\n\n> then the type of array is int so size of int is \n        4 Bytes and the size of Array is 5\n        then the total space required is \n        4 * 5 = 20 bytes of memory\n\n> For example the memory location 2004 is starting\n   address for the Array\n\n> The starting address of the Array will be pointing\n    to the identifier Arr",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> first arr variable is pushed into stack memory\n\n> then the type of array is int so size of int is \n        4 Bytes and the size of Array is 5\n        then the total space required is \n        4 * 5 = 20 bytes of memory\n\n> For example the memory location 2004 is starting\n   address for the Array\n\n> The starting address of the Array will be pointing\n    to the identifier Arr",
      "autoResize": true,
      "lineHeight": 1.25
    },
