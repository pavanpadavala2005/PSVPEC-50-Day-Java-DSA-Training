      "seed": 1950382391,
      "version": 2174,
      "versionNonce": 877267447,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778732403365,
      "link": null,
      "locked": false,
      "text": "> According to the formula if array indexing start from 1\nthen it will lead to mismatch",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> According to the formula if array indexing start from 1\nthen it will lead to mismatch",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qUcNOq0QKeZB95319GLWV",
      "type": "text",
      "x": 28942.12676531215,
      "y": -12196.46139395507,
      "width": 505.83575439453125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VCkLsBTbosUV-dF8ouRUe"
      ],
      "frameId": null,
      "index": "bDM",
      "roundness": null,
      "seed": 375428087,
      "version": 2262,
      "versionNonce": 346879225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778732403365,
      "link": null,
      "locked": false,
      "text": "Ex: arr[1] = 2004 + ( 1 * 4 )\n             = 2008",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ex: arr[1] = 2004 + ( 1 * 4 )\n             = 2008",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lLuEtXZxeGzy6RSOdvKvB",
      "type": "text",
      "x": 28941.412501396135,
      "y": -12059.675657871087,
      "width": 944.495849609375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VCkLsBTbosUV-dF8ouRUe"
      ],
      "frameId": null,
      "index": "bDN",
      "roundness": null,
      "seed": 1941083735,
      "version": 2414,
      "versionNonce": 277066519,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778732403365,
      "link": null,
      "locked": false,
      "text": "but if we read from 2008 we will get the position of \narr[2] not arr[1]\n\nso Array Index will start from 0",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "but if we read from 2008 we will get the position of \narr[2] not arr[1]\n\nso Array Index will start from 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
