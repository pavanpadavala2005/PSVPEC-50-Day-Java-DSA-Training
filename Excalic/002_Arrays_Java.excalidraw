      "updated": 1778733097968,
      "link": null,
      "locked": false,
      "text": "for Example lets take 2D array\n\nint[][] arr = new int[3][3];",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for Example lets take 2D array\n\nint[][] arr = new int[3][3];",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "20LKjLu8aX2Ng5HhPped2",
      "type": "text",
      "x": 31928.242220556935,
      "y": -15528.287813757479,
      "width": 1023.2276611328125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
