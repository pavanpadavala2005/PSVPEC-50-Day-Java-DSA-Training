      "updated": 1779939449485,
      "link": null,
      "locked": false,
      "text": "In Java, a String is an object used to store a sequence of characters.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Java, a String is an object used to store a sequence of characters.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IJqBIVshJMQDgZ0liVI4G",
      "type": "text",
      "x": 20820,
      "y": -15160,
      "width": 1053.215576171875,
