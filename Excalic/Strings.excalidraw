      "isDeleted": false,
      "boundElements": null,
      "updated": 1779940472024,
      "link": null,
      "locked": false,
      "text": "store sensitive data like database URLs, usernames, passwords, \nand file paths. If they were mutable, a malicious program could \nchange these values",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "store sensitive data like database URLs, usernames, passwords, \nand file paths. If they were mutable, a malicious program could \nchange these values",
      "autoResize": true,
      "lineHeight": 1.25
    },
