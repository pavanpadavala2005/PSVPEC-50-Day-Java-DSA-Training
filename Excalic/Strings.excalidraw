      "isDeleted": false,
      "boundElements": null,
      "updated": 1779940249632,
      "link": null,
      "locked": false,
      "text": "Strings are immutable in every programming language because",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strings are immutable in every programming language because",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4n9AZA8db3xD1s8a057mM",
      "type": "text",
      "x": 20820,
      "y": -15080,
      "width": 1141.4515380859375,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
