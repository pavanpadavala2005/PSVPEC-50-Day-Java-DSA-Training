    {
      "id": "UuM_bHWrToTzgOa8no5fn",
      "type": "text",
      "x": 20793.225958377032,
      "y": -13945.605391184976,
      "width": 845.2260721712735,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yp72rg01vjl9J8WxdHg1T"
      ],
      "frameId": null,
      "index": "bC2",
      "roundness": null,
      "seed": 792094498,
      "version": 415,
      "versionNonce": 662961406,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779942968700,
      "link": null,
      "locked": false,
      "text": "Whenever we are doing series of concatinations\nfor everytime a new string object\n\nOld objects remain in memory until Garbage\nCollector removes\n\n--> Extra heap memory usage\n--> More garbage objects\n--> Increased GC work",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Whenever we are doing series of concatinations \nfor everytime a new string object\n\nOld objects remain in memory until Garbage Collector removes\n\n--> Extra heap memory usage\n--> More garbage objects\n--> Increased GC work",
      "autoResize": false,
      "lineHeight": 1.25
    },
